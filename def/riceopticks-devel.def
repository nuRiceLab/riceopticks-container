Bootstrap: localimage
From: optix-base.sif

# =============================================================================
# RiceOpticks DEVELOPMENT image  (on the fnal-wn-el9 + CUDA13 + OptiX base)
#
#   * OptiX SDK headers KEPT (needed to compile apps against Opticks)
#   * Only the system -devel packages the fnal-wn-el9 base LACKS are dnf-installed
#     (base already provides expat/zlib/openssl/libX11/mesa-libGLU)
#   * Geant4/CLHEP/Xerces/ROOT from DUNE Spack v1.2.2 (dune-prototype env)
#   * ships /opt/opticks-dev-env.sh : one-shot build environment for downstream apps
#
# BUILD:   requires /cvmfs mounted  ->  build with:  --bind /cvmfs
# RUNTIME: requires /cvmfs mounted AND an R580+ driver via --nv
#
# BRANCH: checks out RiceOpticks 'v1.0r_production'. For a reproducible image,
# replace the branch with a specific commit hash on the checkout line.
# =============================================================================

%post -c /bin/bash
    set -eux

    mkdir -p /cvmfs

    # ----- Phase 1: ONLY the -devel packages fnal-wn-el9 lacks (dnf before Spack) -----
    dnf -y install \
        boost-devel libuuid-devel \
        libXrandr-devel libXinerama-devel libXcursor-devel libXi-devel \
        mesa-libGL-devel \
        qt5-qtbase-devel \
        git which findutils
    dnf clean all

    # ----- Phase 2: clone RiceOpticks (dir MUST be named 'opticks') -----
    git clone https://github.com/nuRiceLab/RiceOpticks /opt/opticks
    git -C /opt/opticks checkout v1.0r_production
    # reproducible alternative:  git -C /opt/opticks checkout <40-char-commit-hash>

    # ----- Phase 3: Spack v1.2.2 + v3 compiler + physics externals -----
    set +eu
    source /cvmfs/dune.opensciencegrid.org/spack/v1.2.2/share/spack/setup-env.sh
    spack env activate dune-prototype
    spack load gcc@12.5.0 arch=linux-almalinux9-x86_64_v3
    spack load geant4@11.2.2 clhep@2.4.7.1 xerces-c@3.3.0
    set -eu

    # Re-assert container CUDA 13 over Spack's CUDA (12.6.x) - MUST win.
    export PATH=/usr/local/cuda/bin:$PATH
    export CC=$(which gcc)
    export CXX=$(which g++)
    export CUDA_HOME=/usr/local/cuda
    export CUDACXX=/usr/local/cuda/bin/nvcc
    export CUDAToolkit_ROOT=/usr/local/cuda
    nvcc --version | grep -q "release 13" || { echo "FATAL: nvcc is not CUDA 13"; exit 1; }

    # ----- Phase 4: derive prefixes + exports -----
    export G4_PREFIX=$(spack location -i geant4@11.2.2)
    export CLHEP_PREFIX=$(spack location -i clhep@2.4.7.1)
    export XP=$(spack location -i xerces-c@3.3.0)
    test -n "$G4_PREFIX" || { echo "FATAL: geant4@11.2.2 not found in env"; exit 1; }

    export Geant4_DIR=$(dirname "$(find "$G4_PREFIX" -name Geant4Config.cmake | head -1)")
    export OPTICKS_GEANT4_PREFIX=$G4_PREFIX
    export XERCESC_INCLUDE_DIR=$XP/include
    export XERCESC_LIBRARY=$(ls $XP/lib/libxerces-c*.so | head -1)
    test -f "$Geant4_DIR/Geant4Config.cmake" || { echo "FATAL: Geant4Config.cmake missing"; exit 1; }

    export OPTICKS_HOME=/opt/opticks
    export OPTICKS_PREFIX=/usr/local/opticks
    export OPTICKS_CUDA_PREFIX=/usr/local/cuda
    export OPTICKS_OPTIX_PREFIX=/opt/optix/current
    export OPTICKS_COMPUTE_CAPABILITY=75            # <-- SET TO DEPLOYMENT GPU: 86=Ampere, 89=Ada
    export PYTHONPATH=/opt
    export CUDAHOSTCXX=$(which g++)
    export CMAKE_PREFIX_PATH=/usr/local/cuda:$G4_PREFIX:$CLHEP_PREFIX:$XP

    # ----- Phase 5: build Opticks (GPU-prep auto-skips; no GPU at build time) -----
    set +eu # Opticks scripts reference unset vars (VERBOSE, ...)
    source /opt/opticks/opticks.bash
    opticks-env
    opticks-info
    opticks-full
    rc=$?
    set -e
    # verify the build actually produced the core libraries, and honor the exit code
    test "$rc" -eq 0 || { echo "FATAL: opticks-full returned $rc"; exit 1; }
    test -f /usr/local/opticks/lib64/libCSGOptiX.so || { echo "FATAL: libCSGOptiX.so not built"; exit 1; }
    echo "Opticks build verified: libCSGOptiX.so present."
    # DEVEL image: /opt/optix is intentionally NOT stripped.

    # ----- runtime "source and go" env (for RUNNING Opticks) -----
    cat > /opt/setup.sh <<'EOS'
#!/bin/bash
# RiceOpticks RUNTIME environment. Source this to run Opticks.
source /cvmfs/dune.opensciencegrid.org/spack/v1.2.2/share/spack/setup-env.sh
spack env activate dune-prototype
spack load gcc@12.5.0 arch=linux-almalinux9-x86_64_v3
spack load geant4@11.2.2 clhep@2.4.7.1 xerces-c@3.3.0
export PATH=/usr/local/cuda/bin:$PATH
export OPTICKS_HOME=/opt/opticks
export OPTICKS_PREFIX=/usr/local/opticks
export OPTICKS_CUDA_PREFIX=/usr/local/cuda
export OPTICKS_OPTIX_PREFIX=/opt/optix/current
export PYTHONPATH=/opt
[ -f /usr/local/opticks/bin/opticks-setup.sh ] && source /usr/local/opticks/bin/opticks-setup.sh
EOS
    chmod +x /opt/setup.sh

    # ----- BUILD "source and go" env (for COMPILING apps against RiceOpticks) -----
    cat > /opt/opticks-dev-env.sh <<'DEVEOF2'
#!/bin/bash
# RiceOpticks BUILD environment. Source this to COMPILE an application against
# RiceOpticks. Adds ROOT, BCM, Qt, CUDA 13, and every cmake prefix needed.
#
# Usage:
#   source /opt/opticks-dev-env.sh
#   cd myapp && mkdir -p build && cd build
#   cmake -DWith_Opticks=true -DWITH_GEANT4_VIS=false \
#         -DGeant4_DIR=$Geant4_DIR -DROOT_DIR=$ROOT_DIR -DBCM_DIR=$BCM_DIR \
#         -DCUDAToolkit_ROOT=/usr/local/cuda -DOptiX_INSTALL_DIR=/opt/optix/current ..
#   make -j$(nproc)

source /opt/setup.sh
spack load root@6.28.12 2>/dev/null || spack load root 2>/dev/null

export G4_PREFIX=$(spack location -i geant4@11.2.2 2>/dev/null)
export CLHEP_PREFIX=$(spack location -i clhep@2.4.7.1 2>/dev/null)
export XERCES_PREFIX=$(spack location -i xerces-c@3.3.0 2>/dev/null)
export ROOT_PREFIX=$(spack location -i root@6.28.12 2>/dev/null || spack location -i root 2>/dev/null)
export Geant4_DIR=$(dirname "$(find "$G4_PREFIX" -name Geant4Config.cmake 2>/dev/null | head -1)")
export ROOT_DIR=$(dirname "$(find "$ROOT_PREFIX" -name ROOTConfig.cmake 2>/dev/null | head -1)")

export PATH=/usr/local/cuda/bin:$PATH
export CUDAToolkit_ROOT=/usr/local/cuda
export OPTICKS_HOME=/opt/opticks
export OptiX_INSTALL_DIR=/opt/optix/current
export BCM_DIR=/usr/local/opticks/externals/share/bcm/cmake

# Qt: OpticalSims includes a bare <QtGlobal>; qt5 headers live under /usr/include/qt5
export CPLUS_INCLUDE_PATH=/usr/include/qt5:/usr/include/qt5/QtCore:${CPLUS_INCLUDE_PATH}

export CMAKE_PREFIX_PATH=/usr/local/cuda:/opt/optix/current:${OPTICKS_PREFIX}:/usr/local/opticks/externals:${G4_PREFIX}:${CLHEP_PREFIX}:${XERCES_PREFIX}:${ROOT_PREFIX}
export CMAKE_MODULE_PATH=/usr/local/opticks/externals/share/bcm/cmake

echo "RiceOpticks build environment ready:"
echo "  nvcc       : $(which nvcc)   ($(nvcc --version | grep -o 'release [0-9.]*'))"
echo "  Geant4_DIR : $Geant4_DIR"
echo "  ROOT_DIR   : $ROOT_DIR"
echo "  BCM_DIR    : $BCM_DIR"
echo "  Qt headers : /usr/include/qt5"
DEVEOF2
    chmod +x /opt/opticks-dev-env.sh

%environment
    export OPTICKS_HOME=/opt/opticks
    export OPTICKS_PREFIX=/usr/local/opticks
    export OPTICKS_OPTIX_PREFIX=/opt/optix/current
    export PYTHONPATH=/opt

%runscript
    source /opt/setup.sh
    exec "$@"

%labels
    RiceOpticks_Version v1.0r_production
    Image_Type devel
    Base fnal-wn-el9_almalinux9.8
    Geant4 11.2.2_spack_v1.2.2
    CUDA 13.0.3
    OptiX 9.0.0
    Driver_Floor R580
    GPU_Arch_Floor Turing_sm75

%help
    RiceOpticks DEVELOPMENT image on the Fermilab EL9 base.
    To COMPILE an app (e.g. OpticalSims):
      apptainer shell --nv --bind /cvmfs riceopticks-devel.sif
      source /opt/opticks-dev-env.sh
      cd app && mkdir build && cd build
      cmake -DWith_Opticks=true -DWITH_GEANT4_VIS=false \
            -DGeant4_DIR=$Geant4_DIR -DROOT_DIR=$ROOT_DIR -DBCM_DIR=$BCM_DIR \
            -DCUDAToolkit_ROOT=/usr/local/cuda -DOptiX_INSTALL_DIR=/opt/optix/current ..
      make -j$(nproc)
    Requires /cvmfs and an R580+ driver via --nv.
