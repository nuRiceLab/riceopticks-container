Bootstrap: localimage
From: /cvmfs/singularity.opensciencegrid.org/fermilab/fnal-wn-el9:latest

# =============================================================================
# OptiX + CUDA base image  (DUNE-aligned)
#
# Foundation for the RiceOpticks stack:
#   * Base: Fermilab worker-node EL9 (AlmaLinux 9.8) - same userspace as dunesw
#   * CUDA 13.0 toolkit installed from NVIDIA's rhel9 repo (-> /usr/local/cuda)
#   * NVIDIA OptiX 9.0.0 headers installed from an injected SDK
#
# The GPU DRIVER is NOT included - it comes from the host at run time via --nv.
# Host requirement to RUN anything built on this: NVIDIA R580+ driver, Turing+ GPU.
#
# BUILD REQUIREMENT: the build host needs network access to
# developer.download.nvidia.com (to fetch the CUDA toolkit during %post).
# =============================================================================

%files
    # Injected OptiX SDK installer (downloaded manually; NVIDIA-licensed, not redistributable)
    vendor/NVIDIA-OptiX-SDK-9.0.0-linux64-x86_64.sh /opt/optix-installer.sh

%post
    set -eux

    mkdir -p /cvmfs                     # runtime bind mountpoint for downstream images

    # ----- CUDA 13.0 toolkit from NVIDIA's repo -----
    dnf install -y dnf-plugins-core
    dnf config-manager --add-repo \
        https://developer.download.nvidia.com/compute/cuda/repos/rhel9/x86_64/cuda-rhel9.repo
    # Pin to the 13-0 series (13.0.3) to match hosts running CUDA 13.0 / libcudart.so.13
    dnf install -y cuda-toolkit-13-0
    dnf clean all

    # cuda-toolkit-13-0 installs to /usr/local/cuda-13.0 and creates a /usr/local/cuda symlink.
    # Ensure the symlink exists (some layouts require it explicitly):
    [ -e /usr/local/cuda ] || ln -s /usr/local/cuda-13.0 /usr/local/cuda
    /usr/local/cuda/bin/nvcc --version | grep -q "release 13" || { echo "FATAL: CUDA is not 13"; exit 1; }

    # ----- OptiX 9.0.0 headers -----
    mkdir -p /opt/optix
    sh /opt/optix-installer.sh --skip-license --prefix=/opt/optix --include-subdir
    rm -f /opt/optix-installer.sh
    OPTIX_DIR=$(find /opt/optix -maxdepth 1 -type d -name "NVIDIA-OptiX-SDK-9.0.0*" | head -n1)
    ln -sfn "$OPTIX_DIR" /opt/optix/current

    # ----- build-time verification (no GPU needed) -----
    grep "define OPTIX_VERSION" /opt/optix/current/include/optix.h    # expect 90000
    printf '#include <optix.h>\n#include <optix_stubs.h>\nint main(){return 0;}\n' > /opt/t.c
    gcc -I/opt/optix/current/include -I/usr/local/cuda/include -c /opt/t.c -o /opt/t.o
    rm -f /opt/t.c /opt/t.o
    echo "OptiX 9.0.0 headers verified against CUDA 13 toolkit."

%environment
    export PATH=/usr/local/cuda/bin:${PATH}
    export OptiX_INSTALL_DIR=/opt/optix/current
    export OPTICKS_OPTIX_PREFIX=/opt/optix/current
    export OPTICKS_CUDA_PREFIX=/usr/local/cuda
    export CPATH=/opt/optix/current/include:${CPATH:-}
    export OPTICKS_COMPUTE_CAPABILITY=75

%labels
    Base fnal-wn-el9_almalinux9.8
    CUDA 13.0.3_toolkit_baked
    OptiX 9.0.0
    Driver_Floor R580
    GPU_Arch_Floor Turing_sm75

%help
    OptiX 9.0.0 + CUDA 13.0 toolkit on the Fermilab EL9 worker-node base.
    Driver comes from the host via --nv (R580+). Foundation for riceopticks-devel.def.
