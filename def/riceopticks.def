Bootstrap: localimage
From: optix-base.sif

# =============================================================================
# RiceOpticks image  (nuRiceLab/RiceOpticks)
#
# Single image serving BOTH use cases:
#   * RUN Opticks executables                -> source /opt/setup.sh
#   * COMPILE an app against RiceOpticks     -> source /opt/opticks-dev-env.sh
#
# Supersedes the former riceopticks.def / riceopticks-devel.def pair. The old
# split existed because riceopticks.def deleted /opt/optix to avoid shipping the
# NVIDIA OptiX SDK. That is no longer necessary: optix-base.def now takes the
# ~700 kB header-only NVIDIA/optix-dev repo instead of the full SDK installer,
# so keeping the headers costs nothing and downstream `find_package` works.
#
# Why the headers must stay:
#   CSGOptiX/CMakeLists.txt adds ${OpticksOptiX_INCLUDE} PUBLIC with no
#   $<BUILD_INTERFACE:> guard, so the absolute OptiX include path is baked into
#   the installed CSGOptiXTargets.cmake. FindOpticksOptiX.cmake then resolves it
#   from $ENV{OPTICKS_OPTIX_PREFIX}/include with NO_DEFAULT_PATH. Any downstream
#   find_package therefore fails at CONFIGURE time when /opt/optix is missing,
#   even for apps that only use G4CXOpticks.hh and never include <optix.h>.
#
# Build-time deps:  /cvmfs mounted   ->  apptainer build --bind /cvmfs ...
# Runtime deps:     /cvmfs mounted AND an R580+ driver via --nv
#
# This image is NOT self-contained: Geant4/CLHEP/Xerces-C/ROOT and the gcc 12.5
# libstdc++ that Opticks is compiled against all load from the DUNE Spack stack
# on CVMFS at run time. It is pinned to that exact Spack environment revision.
# =============================================================================

# Requires Apptainer >= 1.3. On older Apptainer/Singularity, delete this block
# and replace every {{ NAME }} below with its literal default.
%arguments
    RICEOPTICKS_COMMIT=a7b1e6bdacc15eede646d2f0ae43ae62a89e7c7d
    RICEOPTICKS_VERSION=v1.0r_09_04_2026
    COMPUTE_CAPABILITY=75

%post -c /bin/bash
    set -eux

    mkdir -p /cvmfs                            # runtime bind mountpoint

    # ----- Phase 1: system deps FIRST (dnf segfaults under a loaded Spack) -----
    # Union of the two former def files. Some of these may already be present in
    # the fnal-wn-el9 base; dnf is a no-op for those and the list is cheap.
    # 'curl' omitted on purpose: base ships curl-minimal, which conflicts.
    # 'xerces-c-devel' omitted on purpose: Xerces comes from Spack, not the OS.
    dnf -y install \
        boost-devel expat-devel zlib-devel openssl-devel libuuid-devel \
        libX11-devel libXrandr-devel libXinerama-devel libXcursor-devel \
        libXi-devel mesa-libGL-devel mesa-libGLU-devel \
        qt5-qtbase-devel \
        python3 which findutils git
    dnf clean all

    # ----- Phase 2: clone RiceOpticks at a PINNED COMMIT -----
    # The directory MUST be named 'opticks': the repo ships an __init__.py and
    # `import opticks` needs a dir literally called 'opticks' on PYTHONPATH.
    #
    # Pinned by hash, not branch. v1.0r_production is a moving target: as of
    # 2026-08-20 its tip is c29ce502b, three commits past the 754d992 that the
    # published v1.0r image was built from. Bump RICEOPTICKS_COMMIT and
    # RICEOPTICKS_VERSION together when cutting a new release.
    git clone https://github.com/nuRiceLab/RiceOpticks /opt/opticks
    git -C /opt/opticks checkout {{ RICEOPTICKS_COMMIT }}
    git -C /opt/opticks rev-parse HEAD | grep -q '{{ RICEOPTICKS_COMMIT }}' \
        || { echo "FATAL: RiceOpticks is not at the pinned commit"; exit 1; }

    # ----- Phase 3: Spack env + v3 compiler + physics externals -----
    # Relax errexit/nounset around the CVMFS scripts: they touch unset vars and
    # can return non-zero benignly. The explicit gates below catch real failures.
    set +eu
    source /cvmfs/dune.opensciencegrid.org/spack/v1.2.2/share/spack/setup-env.sh
    spack env activate dune-prototype          # <-- must provide geant4@11.2.2
    spack load gcc@12.5.0 arch=linux-almalinux9-x86_64_v3
    spack load geant4@11.2.2 clhep@2.4.7.1 xerces-c@3.3.0
    set -eu

    # Re-assert container CUDA 13 over Spack's CUDA (12.6.x). This MUST win.
    export PATH=/usr/local/cuda/bin:$PATH
    export CC=$(which gcc)
    export CXX=$(which g++)
    export CUDA_HOME=/usr/local/cuda
    export CUDACXX=/usr/local/cuda/bin/nvcc
    export CUDAHOSTCXX=$(which g++)
    export CUDAToolkit_ROOT=/usr/local/cuda

    # Hard gate: fail loudly if the toolchain is not what we expect.
    nvcc --version | grep -q "release 13" || { echo "FATAL: nvcc is not CUDA 13"; exit 1; }

    # OptiX headers must have survived optix-base.def.
    test -f /opt/optix/current/include/optix.h \
        || { echo "FATAL: OptiX headers missing from base image"; exit 1; }
    grep -q "define OPTIX_VERSION 90000" /opt/optix/current/include/optix.h \
        || { echo "FATAL: OptiX headers are not 9.0.0"; exit 1; }

    # ----- Phase 4: derive prefixes (never hand-type CVMFS hashes) + exports ---
    export G4_PREFIX=$(spack location -i geant4@11.2.2)
    export CLHEP_PREFIX=$(spack location -i clhep@2.4.7.1)
    export XP=$(spack location -i xerces-c@3.3.0)
    test -n "$G4_PREFIX" || { echo "FATAL: geant4@11.2.2 not found in env"; exit 1; }

    export Geant4_DIR=$(dirname "$(find "$G4_PREFIX" -name Geant4Config.cmake | head -1)")
    export OPTICKS_GEANT4_PREFIX=$G4_PREFIX
    export XERCESC_INCLUDE_DIR=$XP/include
    export XERCESC_LIBRARY=$(ls $XP/lib/libxerces-c*.so | head -1)
    test -f "$Geant4_DIR/Geant4Config.cmake" || { echo "FATAL: Geant4Config.cmake missing"; exit 1; }

    export OPTICKS_HOME=/opt/opticks
    export OPTICKS_PREFIX=/usr/local/opticks
    export OPTICKS_CUDA_PREFIX=/usr/local/cuda          # container CUDA 13, NOT Spack's
    export OPTICKS_OPTIX_PREFIX=/opt/optix/current
    export OPTICKS_COMPUTE_CAPABILITY={{ COMPUTE_CAPABILITY }}
    export PYTHONPATH=/opt
    export CMAKE_PREFIX_PATH=/usr/local/cuda:$G4_PREFIX:$CLHEP_PREFIX:$XP

    # ----- Phase 5: build (GPU-prep auto-skips; no GPU needed at build time) ---
    set +eu   # Opticks scripts reference unset vars (VERBOSE, ...)
    source /opt/opticks/opticks.bash
    opticks-env
    opticks-info
    opticks-full
    rc=$?
    set -eu

    test "$rc" -eq 0 || { echo "FATAL: opticks-full returned $rc"; exit 1; }
    test -f /usr/local/opticks/lib64/libCSGOptiX.so \
        || { echo "FATAL: libCSGOptiX.so not built"; exit 1; }
    echo "Opticks build verified: libCSGOptiX.so present."

    # /opt/optix is intentionally NOT stripped. See header comment.

    # ----- runtime "source and go" env (for RUNNING Opticks) -----
    # Quoted 'EOS' => contents are literal, no expansion at build time.
    cat > /opt/setup.sh <<'EOS'
#!/bin/bash
# RiceOpticks RUNTIME environment. Source this to run Opticks.
# Needs /cvmfs (dune + larsoft) mounted, and an R580+ driver via --nv.
source /cvmfs/dune.opensciencegrid.org/spack/v1.2.2/share/spack/setup-env.sh
spack env activate dune-prototype
spack load gcc@12.5.0 arch=linux-almalinux9-x86_64_v3
spack load geant4@11.2.2 clhep@2.4.7.1 xerces-c@3.3.0

# container CUDA 13 must win over Spack's CUDA
export PATH=/usr/local/cuda/bin:$PATH

export OPTICKS_HOME=/opt/opticks
export OPTICKS_PREFIX=/usr/local/opticks
export OPTICKS_CUDA_PREFIX=/usr/local/cuda
: "${OPTICKS_OPTIX_PREFIX:=/opt/optix/current}"
export OPTICKS_OPTIX_PREFIX
export PYTHONPATH=/opt

# Opticks-generated runtime setup (executable + library paths)
[ -f /usr/local/opticks/bin/opticks-setup.sh ] && source /usr/local/opticks/bin/opticks-setup.sh
EOS
    chmod +x /opt/setup.sh

    # ----- BUILD "source and go" env (for COMPILING apps against RiceOpticks) --
    cat > /opt/opticks-dev-env.sh <<'DEVEOF'
#!/bin/bash
# RiceOpticks BUILD environment. Source this to COMPILE an application against
# RiceOpticks. Adds ROOT, BCM, Qt, CUDA 13, and every cmake prefix needed.
#
# Usage:
#   source /opt/opticks-dev-env.sh
#   cmake -S myapp -B build -DWith_Opticks=true -DWITH_GEANT4_VIS=false \
#         -DGeant4_DIR=$Geant4_DIR -DROOT_DIR=$ROOT_DIR -DBCM_DIR=$BCM_DIR \
#         -DCUDAToolkit_ROOT=/usr/local/cuda -DOptiX_INSTALL_DIR=$OptiX_INSTALL_DIR
#   cmake --build build -j$(nproc)

source /opt/setup.sh
spack load root@6.28.12 2>/dev/null || spack load root 2>/dev/null

export G4_PREFIX=$(spack location -i geant4@11.2.2 2>/dev/null)
export CLHEP_PREFIX=$(spack location -i clhep@2.4.7.1 2>/dev/null)
export XERCES_PREFIX=$(spack location -i xerces-c@3.3.0 2>/dev/null)
export ROOT_PREFIX=$(spack location -i root@6.28.12 2>/dev/null || spack location -i root 2>/dev/null)
export Geant4_DIR=$(dirname "$(find "$G4_PREFIX" -name Geant4Config.cmake 2>/dev/null | head -1)")
export ROOT_DIR=$(dirname "$(find "$ROOT_PREFIX" -name ROOTConfig.cmake 2>/dev/null | head -1)")

export PATH=/usr/local/cuda/bin:$PATH
export CUDAToolkit_ROOT=/usr/local/cuda
export OPTICKS_HOME=/opt/opticks
export BCM_DIR=/usr/local/opticks/externals/share/bcm/cmake

# OptiX headers. Defaults to the copy baked into the image. Override by setting
# OPTICKS_OPTIX_PREFIX before sourcing, e.g. to a personal clone of
# https://github.com/NVIDIA/optix-dev at tag v9.0.0.
: "${OPTICKS_OPTIX_PREFIX:=/opt/optix/current}"
export OPTICKS_OPTIX_PREFIX
export OptiX_INSTALL_DIR="$OPTICKS_OPTIX_PREFIX"
if [ ! -f "$OPTICKS_OPTIX_PREFIX/include/optix.h" ]; then
    echo "ERROR: no optix.h under $OPTICKS_OPTIX_PREFIX/include" >&2
    echo "       cmake configure will fail in FindOpticksOptiX.cmake." >&2
fi

# Qt: OpticalSims includes a bare <QtGlobal>; qt5 headers live under /usr/include/qt5
export CPLUS_INCLUDE_PATH=/usr/include/qt5:/usr/include/qt5/QtCore:${CPLUS_INCLUDE_PATH:-}

export CMAKE_PREFIX_PATH=/usr/local/cuda:${OPTICKS_OPTIX_PREFIX}:/usr/local/opticks:/usr/local/opticks/externals:${G4_PREFIX}:${CLHEP_PREFIX}:${XERCES_PREFIX}:${ROOT_PREFIX}
export CMAKE_MODULE_PATH=/usr/local/opticks/externals/share/bcm/cmake

echo "RiceOpticks build environment ready:"
echo "  nvcc       : $(which nvcc)   ($(nvcc --version | grep -o 'release [0-9.]*'))"
echo "  Geant4_DIR : $Geant4_DIR"
echo "  ROOT_DIR   : $ROOT_DIR"
echo "  BCM_DIR    : $BCM_DIR"
echo "  OptiX      : $OptiX_INSTALL_DIR"
echo "  Qt headers : /usr/include/qt5"
DEVEOF
    chmod +x /opt/opticks-dev-env.sh

%environment
    # Kept minimal on purpose. The heavy runtime setup (Spack loads for the
    # gcc-12.5 libstdc++ that Opticks was compiled against, plus Geant4/CLHEP/
    # Xerces libs) lives in /opt/setup.sh, which %runscript sources for you.
    # `apptainer shell` does NOT run %runscript: source /opt/setup.sh by hand.
    export OPTICKS_HOME=/opt/opticks
    export OPTICKS_PREFIX=/usr/local/opticks
    export OPTICKS_OPTIX_PREFIX=/opt/optix/current
    export PYTHONPATH=/opt

%runscript
    source /opt/setup.sh
    if [ $# -eq 0 ]; then
        exec bash            # bare `apptainer run` gives a set-up shell
    else
        exec "$@"
    fi

%labels
    RiceOpticks_Version {{ RICEOPTICKS_VERSION }}
    RiceOpticks_Commit {{ RICEOPTICKS_COMMIT }}
    Geant4 11.2.2_spack_cvmfs_v1.2.2
    CLHEP 2.4.7.1
    Xerces_C 3.3.0
    Compiler gcc_12.5.0_cvmfs
    Base fnal-wn-el9_almalinux9.8
    CUDA 13.0.3
    OptiX 9.0.0_headers_only
    Driver_Floor R580
    GPU_Arch_Floor Turing_sm{{ COMPUTE_CAPABILITY }}

%help
    RiceOpticks built against OptiX 9.0.0 + CUDA 13.0, with Geant4 11.2.2 /
    CLHEP / Xerces-C / ROOT from the DUNE Spack stack on CVMFS.

    Requires at runtime:
      * /cvmfs mounted (dune.opensciencegrid.org + larsoft.opensciencegrid.org)
      * NVIDIA R580+ driver, Turing (sm_75) or newer GPU, exposed via --nv

    RUN Opticks (environment set up for you by %runscript):
      apptainer run  --nv --bind /cvmfs riceopticks.sif opticks-info
      apptainer run  --nv --bind /cvmfs riceopticks.sif bash

    Equivalent with shell/exec, which do NOT run %runscript:
      apptainer shell --nv --bind /cvmfs riceopticks.sif
        Apptainer> source /opt/setup.sh
      apptainer exec  --nv --bind /cvmfs riceopticks.sif \
        bash -lc 'source /opt/setup.sh; opticks-info'

    COMPILE an app against RiceOpticks (e.g. OpticalSims):
      apptainer run --nv --bind /cvmfs --bind $PWD riceopticks.sif bash
        Apptainer> source /opt/opticks-dev-env.sh
        Apptainer> cmake -S myapp -B build -DWith_Opticks=true -DWITH_GEANT4_VIS=false \
                     -DGeant4_DIR=$Geant4_DIR -DROOT_DIR=$ROOT_DIR -DBCM_DIR=$BCM_DIR \
                     -DCUDAToolkit_ROOT=/usr/local/cuda -DOptiX_INSTALL_DIR=$OptiX_INSTALL_DIR
        Apptainer> cmake --build build -j$(nproc)

# Assert the U4 API that laropticks requires is present. Without this the
# mismatch only surfaces later as a compile error in OpticksInterface.cc.
    grep -q "CollectGenstep_DsG4Scintillation_r4695_LArSoftv2" \
        "$OPTICKS_PREFIX/include/U4/U4.hh" \
        || { echo "FATAL: U4 lacks the LArSoftv2 API required by laropticks"; exit 1; }


